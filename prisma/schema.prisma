datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CITIZEN
  STAFF
  ADMIN
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String?
  phone        String?
  organization String?
  role         Role         @default(CITIZEN)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  bookings     Booking[]
  auditEvents  AuditEvent[]

  @@map("users")
}

model Hall {
  id                 String              @id @default(cuid())
  slug               String              @unique
  name               String
  description        String
  hourlyRate         Decimal             @default(0.0)
  capacity           Int
  location           String
  address            String
  amenities          String[]
  images             String[]
  isActive           Boolean             @default(true)
  rulesAndPolicies   String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  bookings           Booking[]
  maintenanceWindows MaintenanceWindow[]

  @@map("halls")
}

model Booking {
  id                String        @id @default(cuid())
  referenceNumber   String        @unique
  hallId            String
  hall              Hall          @relation(fields: [hallId], references: [id], onDelete: Restrict)
  userId            String?
  user              User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  requesterName     String
  requesterEmail    String
  requesterPhone    String
  requesterOrg      String?
  
  eventName         String
  eventType         String
  expectedAttendees Int
  specialRequests   String?
  
  startTime         DateTime
  endTime           DateTime
  
  status            BookingStatus @default(PENDING)
  reviewedBy        String?
  reviewedAt        DateTime?
  decisionNotes     String?
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([hallId, startTime, endTime])
  @@index([status])
  @@map("bookings")
}

model MaintenanceWindow {
  id        String            @id @default(cuid())
  hallId    String
  hall      Hall              @relation(fields: [hallId], references: [id], onDelete: Cascade)
  title     String
  reason    String
  startTime DateTime
  endTime   DateTime
  status    MaintenanceStatus @default(SCHEDULED)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([hallId, startTime, endTime])
  @@map("maintenance_windows")
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String
  action     String
  entityType String
  entityId   String
  summary    String
  metadata   Json?
  timestamp  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([timestamp])
  @@map("audit_events")
}
