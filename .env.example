# ==============================================================================
# CivicSpaces Community Hall Booking & Management System
# Environment Configuration Template (Variable Names Only - Never Commit Secrets)
# ==============================================================================

# Supabase Project URL (Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Public Anon Key (Safe for browser/client under Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: New-style Supabase Publishable Key (falls back to ANON_KEY if omitted)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase Service Role Key (SERVER ONLY - NEVER EXPOSE TO CLIENT OR BROWSER)
# Used exclusively in server routes/actions for trusted admin operations.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: New-style Supabase Secret Key (falls back to SERVICE_ROLE_KEY if omitted)
SUPABASE_SECRET_KEY=

# Application URL (used for Supabase Auth email redirect & password recovery links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Display & Booking Schedule Timezone (IANA timezone, stored in UTC in Postgres)
NEXT_PUBLIC_APP_TIMEZONE=Asia/Kolkata

# Optional: Configurable Public Help Desk / Contact Details
NEXT_PUBLIC_PORTAL_NAME=CivicSpaces
NEXT_PUBLIC_DIVISION_NAME=Municipal Facilities Division
NEXT_PUBLIC_SUPPORT_OFFICE=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_HOURS=

# Optional: Development Demo Admin Mode & Cookie Secret
# In production, leave ENABLE_DEMO_ADMIN unset/false and authenticate via Supabase Auth.
ENABLE_DEMO_ADMIN=false
ADMIN_SESSION_SECRET=
