# ==============================================================================
# CivicSpaces Community Hall Booking & Management System
# Environment Configuration Template
# ==============================================================================

# Supabase Project URL
# Where to obtain:
#   1. Sign in to https://supabase.com/dashboard
#   2. Select your project -> Project Settings -> API
#   3. Copy the "Project URL" (e.g., https://your-project-id.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Public Anon Key
# Safe for browser/client use under Row Level Security (RLS).
# Where to obtain:
#   1. Supabase Dashboard -> Project Settings -> API
#   2. Copy the "anon" / "public" API Key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Key (SERVER ONLY - NEVER EXPOSE TO CLIENT)
# Privileged key that bypasses Row Level Security for trusted backend operations,
# administrative actions, and migration seeding.
# Where to obtain:
#   1. Supabase Dashboard -> Project Settings -> API
#   2. Copy the "service_role" secret Key
SUPABASE_SERVICE_ROLE_KEY=

# Application Environment
NODE_ENV=development
